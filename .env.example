APP_NAME=PCB AOI Research Prototype
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DATABASE_URL=sqlite:///./pcb_aoi.db
CORS_ORIGINS=http://localhost:5173
MODEL_PATH=models/weights/yolo11m_official_v4.pt
MODEL_VERSION=yolo11m_official_v4
CONFIDENCE_THRESHOLD=0.25
MAX_UPLOAD_MB=20
VITE_API_BASE_URL=http://localhost:8000
STORAGE_ROOT=reports/inspections
SEVERITY_POLICY_PATH=backend/app/core/severity.yaml
ENABLE_REFERENCE_ANALYSIS=true
ENABLE_POSTPROCESS=true
POSTPROCESS_NMS_IOU=0.2
POSTPROCESS_BOX_SCALE=1.15
MODEL_CARD_PATH=models/model_card.json
AUTO_CREATE_SCHEMA=true
POSTGRES_DB=pcb_aoi
POSTGRES_USER=pcb_aoi
POSTGRES_PASSWORD=change-me-for-production
API_WORKERS=1
